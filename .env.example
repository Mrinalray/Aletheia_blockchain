# ============================
# ALETHEIA — Environment Variables
# Copy this file to .env and fill in your own keys.
# Never commit a real .env file.
# ============================

# Gemini API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# SightEngine Credentials
SIGHTENGINE_USER=your_sightengine_api_user_here
SIGHTENGINE_SECRET=your_sightengine_api_secret_here

# Server Port (optional, default 3001)
PORT=3001

# ============================
# SIH26204 -- Decentralized Media Authenticity Verification Layer
# Blockchain variables (additive; existing vars above are unaffected).
# Leave all of these blank to run in Demo Blockchain Mode, which is
# fully functional for local development/demos but is NOT a real chain.
# ============================

# RPC endpoint for an Ethereum-compatible testnet (Sepolia recommended).
# If left blank, ALCHEMY_API_KEY + BLOCKCHAIN_NETWORK are used to build one.
BLOCKCHAIN_RPC_URL=

# Alchemy API key (used only if BLOCKCHAIN_RPC_URL is blank).
ALCHEMY_API_KEY=

# Which network to target (Sepolia is the default, free testnet).
BLOCKCHAIN_NETWORK=sepolia

# Private key of the wallet used to submit registerMedia() transactions.
# NEVER commit a real private key. Use a dedicated Sepolia-only test wallet
# funded only with free testnet ETH from a faucet.
BLOCKCHAIN_PRIVATE_KEY=

# Deployed address of AlethiaAuthenticityRegistry.sol on the network above.
BLOCKCHAIN_CONTRACT_ADDRESS=
